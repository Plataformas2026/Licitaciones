# --- Datos (SOLO servidor): los mismos valores que tenías en los Secrets de Streamlit ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_KEY=tu-clave

# --- Inicio de sesión (clave PÚBLICA: anon o "publishable"; Project Settings -> API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-o-publishable

# --- Solo en Vercel: evita que onnxruntime-node descargue binarios CUDA enormes ---
# ONNXRUNTIME_NODE_INSTALL=skip
